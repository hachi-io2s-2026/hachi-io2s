PORT=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# --- Solo para la base en la nube (ver docs/DESPLIEGUE.md) ---
# true si la base exige conexion cifrada (TiDB Cloud, Aiven...)
DB_SSL=false
# Conexiones simultaneas por instancia (en Vercel conviene 3)
DB_CONEXIONES=10
# Zona horaria del hotel (por defecto America/Guatemala y -06:00 en MySQL)
# ZONA_HORARIA=America/Guatemala
# DB_ZONA_HORARIA=-06:00
